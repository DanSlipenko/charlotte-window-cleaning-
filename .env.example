# Lead emails from the quote and hiring forms are sent through Resend (https://resend.com).
# Without RESEND_API_KEY the forms show "please call us" instead of sending.
RESEND_API_KEY=
# Comma-separated list of who receives leads.
LEAD_EMAIL_TO=denis@foundersclt.com
# Must be an address on a domain verified in Resend (e.g. foundersclt.com).
LEAD_EMAIL_FROM="Founders Website <website@foundersclt.com>"
